  "description": "My personal website code. ## Update Instructions - `cd protected/wagtail-acyfactory` - `git pull` - `source ./.venv/bin/activate` - `python manage.py migrate` - `python manage.py collectstatic` - Run wagtail daemon from host console.",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "css-compile": "sass --style compressed --source-map --embed-sources --no-error-css --load-path=node_modules scss/custom.scss mysite/static/css/mysite.css",
    "css-lint": "stylelint scss/",
    "css-prefix": "postcss --replace mysite/static/css/mysite.css --use autoprefixer --map",
    "css": "npm-run-all css-compile css-prefix"
  },
